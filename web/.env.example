# Mapbox public access token (pk....) — required for the map to render
VITE_MAPBOX_TOKEN=

# WebSocket URL of the FastAPI backend.
# Local dev default is ws://localhost:8000/ws (used if this is unset).
# In production point this at the deployed Render backend, e.g.:
#   VITE_WS_URL=wss://gtre-api.onrender.com/ws
VITE_WS_URL=
